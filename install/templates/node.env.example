# Seismic node configuration.
#
# Copy to /etc/seismic/node.env (root:root, 0640). This file is the single
# source of truth for a node: systemd units load it through EnvironmentFile=,
# and the seismic-node CLI and installer read the same keys.
#
# Syntax follows systemd EnvironmentFile rules: KEY=value, one per line,
# '#' comments, optional double quotes around values, no shell expansion.
# Keep secrets out of this file; they live at the paths referenced below.
#
# Keys marked [validator] or [observer] apply to one role only. Keys marked
# (default) have a conventional value and are listed so every path is
# visible; change them only if you know every consumer that must follow.
# Keys marked (computed) repeat another key in the form a unit needs, because
# systemd cannot compute one value from another; the validator checks that
# they agree with their source.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# validator | observer
SEISMIC_ROLE=validator
# Node services run as the dedicated `seismic` account created at install
# time; systemd units name it directly, so it is not configurable here.

# ---------------------------------------------------------------------------
# Persistent layout
# ---------------------------------------------------------------------------
RETH_DATA_DIR=/persistence/reth
SUMMIT_DATA_DIR=/persistence/summit
KEYS_DIR=/persistence/keys
# (default) Reth P2P identity, generated at install time.
RETH_P2P_KEY_PATH=/persistence/keys/reth/p2p-key
# (default) Summit key store, generated at install time.
SUMMIT_KEYS_DIR=/persistence/keys/summit
# (default) Summit writes its most serious errors (tracing target "critical")
# to rotating JSON files here as well as to stdout, so an incident record
# survives journal retention and can be collected without journalctl.
SUMMIT_CRITICAL_LOG_DIR=/persistence/summit/critical
# Optional consensus peer list copied into SUMMIT_KEYS_DIR; empty when not
# provided.
SUMMIT_BOOTSTRAPPERS_FILE=
# (computed) Exactly "--bootstrappers <SUMMIT_BOOTSTRAPPERS_FILE>" or empty.
# Summit treats an absent flag as "use genesis peers"; systemd cannot omit
# a flag conditionally, so the unit expands this word-split key instead.
SUMMIT_BOOTSTRAPPERS_ARG=

# ---------------------------------------------------------------------------
# Binaries
# ---------------------------------------------------------------------------
# Binaries live at fixed paths named directly by the systemd units (systemd
# does not allow the program in ExecStart= to come from a variable):
#   /usr/local/bin/summit
#   /usr/local/bin/seismic-reth
#   /usr/local/bin/seismic-centralized-custodian-service
#   /usr/local/bin/seismic-checkpointer
#   /usr/local/bin/mdbx_copy
#   /usr/local/libexec/seismic/summit-checkpoint-runner
#   /usr/local/lib/seismic/prometheus-agent/current/prometheus
# Installation method per component:
#   download  fetch the release tarball for *_VERSION from GitHub and verify
#             its build-provenance attestation with the GitHub CLI (no login
#             needed; installed by the installer)
#   source    clone the repository at *_VERSION and `cargo build --locked`
#   prebuilt  copy the executable at *_PREBUILT_PATH; the installer checks
#             ownership and permissions only, not what the binary is
SUMMIT_INSTALL_METHOD=download
RETH_INSTALL_METHOD=download
# Pinned versions: a release tag (vX.Y.Z). `download` selects that release;
# `source` checks out that tag. A `refs/heads/<branch>` value is accepted for
# source builds of unreleased work and is never downloadable.
SUMMIT_VERSION=v0.1.0
RETH_VERSION=v0.1.0
# Local paths used only when *_INSTALL_METHOD=prebuilt.
SUMMIT_PREBUILT_PATH=
RETH_PREBUILT_PATH=
# WARNING: with RETH_INSTALL_METHOD=prebuilt and CHECKPOINTER_ENABLED=true the
# checkpointer's mdbx_copy must also be supplied, built from the SAME
# seismic-reth checkout as RETH_PREBUILT_PATH (make -C
# crates/storage/libmdbx-rs/mdbx-sys/libmdbx mdbx_copy). An mdbx_copy built
# from a different libmdbx may refuse Reth's database or copy it incorrectly.
# The installer compares the libmdbx version embedded in both binaries and
# refuses a mismatch.
RETH_MDBX_COPY_PREBUILT_PATH=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
GENESIS_PATH=/etc/seismic/genesis.toml
# Execution-layer bootnode enode:// URL (resolved from the bootnode RPC at
# install time), or empty to use the chain's built-in bootnodes.
RETH_BOOTNODE=
# (computed) Exactly "--bootnodes <RETH_BOOTNODE>" or empty; see
# SUMMIT_BOOTSTRAPPERS_ARG.
RETH_BOOTNODES_ARG=
# (default) Engine API socket shared by Reth and Summit.
RETH_ENGINE_IPC=/run/seismic/reth_engine_api.ipc

# [observer] 32-byte hex public key of the parent validator node.
OBSERVER_PARENT_NODE_PUBLIC_KEY=
# [observer] Derivation index assigned by the parent.
OBSERVER_INDEX=0
# [observer] Publicly reachable Summit P2P socket address: IPv4:port or
# [IPv6]:port, an IP literal (Summit does not resolve hostnames).
OBSERVER_PUBLIC_ADDRESS=
# [observer] (computed) Port component of OBSERVER_PUBLIC_ADDRESS.
OBSERVER_P2P_PORT=

# ---------------------------------------------------------------------------
# Centralized Custodian
# ---------------------------------------------------------------------------
# Every node runs a Custodian: Reth fetches its purpose keys from it over
# CUSTODIAN_SOCKET, and validators expose its council API over HTTPS.
CUSTODIAN_DATA_DIR=/persistence/custodian
CUSTODIAN_INSTALL_METHOD=download
CUSTODIAN_VERSION=v0.1.1
CUSTODIAN_PREBUILT_PATH=
# (default) Unix socket Reth uses to fetch purpose keys.
CUSTODIAN_SOCKET=/run/seismic/custodian.sock
# Council HTTP listener; loopback only, port is configurable.
CUSTODIAN_COUNCIL_PORT=7876
# Council Ethereum address for this network (internal testnet default below)
# and the seismic-reth EVM chain ID, from Seismic operations.
CUSTODIAN_COUNCIL_ADDRESS=0xd412c5ecd343e264381ff15afc0ad78a67b79f35
CUSTODIAN_CHAIN_ID=
# [observer] HTTPS base URL of the parent's Custodian.
CUSTODIAN_PARENT_URL=

# ---------------------------------------------------------------------------
# seismic-checkpointer (optional)
# ---------------------------------------------------------------------------
CHECKPOINTER_ENABLED=false
CHECKPOINTS_DIR=/persistence/checkpoints
CHECKPOINTER_INSTALL_METHOD=download
CHECKPOINTER_VERSION=v0.1.1
CHECKPOINTER_PREBUILT_PATH=
# (default) Rendered from this file; not edited by hand.
CHECKPOINTER_CONFIG_PATH=/etc/seismic/seismic-checkpointer.toml

# ---------------------------------------------------------------------------
# HTTPS endpoint
# ---------------------------------------------------------------------------
# custodian-only | full   (OpenResty managed by seismic-node-ops)
# external                (operator-managed terminator)
# disabled                (observers only: a validator must expose its
#                          Custodian, so --check rejects this for validators)
TLS_MODE=custodian-only
# Public domain served by OpenResty; required unless TLS_MODE is disabled or
# external. Must resolve to this host.
DOMAIN=
# Externally visible Custodian base URL, e.g. https://node.example.com/custodian.
# Required with TLS_MODE=external (the managed modes derive it from DOMAIN);
# used in instructions and observer config.
CUSTODIAN_PUBLIC_URL=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# (default) Shared secret for JWT-protected routes; generated at install time.
OPENRESTY_JWT_SECRET_PATH=/etc/seismic/openresty-jwt-secret

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# How metrics leave the node. Summit, Reth, the Custodian and the checkpointer
# always serve Prometheus metrics on loopback (runbook 3.12), for local tooling
# or for a scraper you run yourself. Seismic operations monitor validators
# only: observers never push to Seismic and are never scraped by it. Empty
# selects the role's default: push for validators, off for observers.
#   push  the Prometheus Agent scrapes locally and remote-writes. Validators:
#         to Seismic, with the bearer token Seismic operations issue, and
#         optionally also to your own Prometheus. Observers: to your own
#         Prometheus only (MONITORING_OPERATOR_REMOTE_WRITE_URL required). The
#         metrics endpoints stay private: the managed proxy does not publish
#         them, and yours must not either.
#   pull  [validator] the HTTPS proxy publishes JWT-protected /prom-* routes
#         for Seismic to scrape. Needs a proxy: TLS_MODE=custodian-only or
#         full (managed OpenResty renders the routes; the node's RPC need not
#         be public) or external (your proxy must enforce the same JWT check
#         on them). You mint the token with tools/generate-openresty-jwt.sh
#         and hand it to Seismic operations.
#   off   nothing leaves the node. Validators only by agreement with Seismic
#         operations; observers bring their own metrics pipeline, scraping the
#         loopback endpoints directly, or use push above.
MONITORING_MODE=
# push: node label on every series; for validators agreed with Seismic
# operations, who register the token against it.
MONITORING_NODE_NAME=
# [validator] push: Seismic's remote-write endpoint, from Seismic operations.
MONITORING_REMOTE_WRITE_URL=
# push: a remote-write endpoint you run yourself, so the samples land in your
# own Prometheus. Optional for validators (the agent keeps nothing locally, so
# without this you cannot see your node's metrics), required for observers.
# Must be an https:// URL ending in /api/v1/write, e.g.
# https://prom.example.com:9443/api/v1/write. If your receiver needs a bearer
# token, pass it to `monitoring install` with --operator-token-source.
MONITORING_OPERATOR_REMOTE_WRITE_URL=
# push: WAL directory owned by the agent's own account; must not overlap node
# state. Tokens are copied to /etc/seismic/prometheus-agent/ by
# `seismic-node monitoring install`.
MONITORING_DATA_DIR=/var/lib/seismic-prometheus-agent

# Runtime state written by `seismic-node checkpoint install` lives at fixed
# paths that systemd conditions reference directly:
#   /etc/seismic/checkpoint-start.toml   gates the *-checkpoint units
#   /etc/seismic/weak-subjectivity.toml  trust anchor named by the above
