# Seismic node configuration.
#
# Copy to /etc/seismic/node.env (root:root, 0640). This file is the single
# source of truth for a node: systemd units load it through EnvironmentFile=,
# and the seismic-node CLI and installer read the same keys.
#
# Syntax follows systemd EnvironmentFile rules: KEY=value, one per line,
# '#' comments, optional double quotes around values, no shell expansion.
# Keep secrets out of this file; they live at the paths referenced below.
#
# Keys marked [validator] or [observer] apply to one role only. Keys marked
# (derived) have a fixed default and are listed so every path is visible;
# change them only if you know every consumer that must follow.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# validator | observer
SEISMIC_ROLE=validator
# Unprivileged account that runs every node service.
SERVICE_USER=seismic
SERVICE_GROUP=seismic

# ---------------------------------------------------------------------------
# Persistent layout
# ---------------------------------------------------------------------------
RETH_DATA_DIR=/persistence/reth
SUMMIT_DATA_DIR=/persistence/summit
KEYS_DIR=/persistence/keys
# (derived) Reth P2P identity, generated at install time.
RETH_P2P_KEY_PATH=/persistence/keys/reth/p2p-key
# (derived) Summit key store, generated at install time.
SUMMIT_KEYS_DIR=/persistence/keys/summit
# (derived) Optional consensus peer list; empty when not provided.
SUMMIT_BOOTSTRAPPERS_FILE=
# (derived) Summit critical-event log files, written independently of stdout.
SUMMIT_CRITICAL_LOG_DIR=/persistence/summit/critical

# ---------------------------------------------------------------------------
# Binaries
# ---------------------------------------------------------------------------
SUMMIT_BIN=/usr/local/bin/summit
RETH_BIN=/usr/local/bin/seismic-reth
# (derived) Wrapper that validates checkpoint-start inputs before exec'ing Summit.
SUMMIT_CHECKPOINT_RUNNER=/usr/local/libexec/seismic/summit-checkpoint-runner
# Installation method per component: download | prebuilt | source | deferred
SUMMIT_INSTALL_METHOD=download
RETH_INSTALL_METHOD=download
# Pinned versions. For source builds these are Git refs
# (refs/tags/<tag> or refs/heads/<branch>); for downloads they select the
# release artifact.
SUMMIT_VERSION=refs/tags/internal-testnet-v1
RETH_VERSION=refs/tags/internal-testnet-v1
# Local paths used only when *_INSTALL_METHOD=prebuilt.
SUMMIT_PREBUILT_PATH=
RETH_PREBUILT_PATH=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
GENESIS_PATH=/etc/seismic/genesis.toml
# Execution-layer bootnode enode URL, or empty.
RETH_BOOTNODE=
# (derived) Node services bind to loopback; OpenResty or an operator-managed
# terminator exposes them.
RETH_RPC_BIND=127.0.0.1
SUMMIT_RPC_BIND=127.0.0.1
# (derived) Engine API socket shared by Reth and Summit.
RETH_ENGINE_IPC=/run/seismic/reth_engine_api.ipc

# [observer] 32-byte hex public key of the parent validator node.
OBSERVER_PARENT_NODE_PUBLIC_KEY=
# [observer] Derivation index assigned by the parent.
OBSERVER_INDEX=0
# [observer] Publicly reachable host:port for Summit P2P.
OBSERVER_PUBLIC_ADDRESS=

# ---------------------------------------------------------------------------
# Centralized Custodian (optional)
# ---------------------------------------------------------------------------
CUSTODIAN_ENABLED=false
CUSTODIAN_DATA_DIR=/persistence/custodian
CUSTODIAN_BIN=/usr/local/bin/seismic-centralized-custodian-service
CUSTODIAN_INSTALL_METHOD=download
CUSTODIAN_VERSION=refs/heads/centralized-custodian
CUSTODIAN_PREBUILT_PATH=
# (derived) Unix socket Reth uses to fetch purpose keys.
CUSTODIAN_SOCKET=/run/seismic/custodian.sock
# Council HTTP listener; loopback only, port is configurable.
CUSTODIAN_COUNCIL_PORT=7876
# Council Ethereum address and chain ID for this network.
CUSTODIAN_COUNCIL_ADDRESS=
CUSTODIAN_CHAIN_ID=
# [observer] HTTPS base URL of the parent's Custodian.
CUSTODIAN_PARENT_URL=

# ---------------------------------------------------------------------------
# summit-checkpointer (optional)
# ---------------------------------------------------------------------------
CHECKPOINTER_ENABLED=false
CHECKPOINTS_DIR=/persistence/checkpoints
CHECKPOINTER_BIN=/usr/local/bin/summit-checkpointer
CHECKPOINTER_INSTALL_METHOD=download
CHECKPOINTER_VERSION=main
CHECKPOINTER_PREBUILT_PATH=
# (derived) Rendered from this file; not edited by hand.
CHECKPOINTER_CONFIG_PATH=/etc/seismic/summit-checkpointer.toml
MDBX_COPY_BIN=/usr/local/bin/mdbx_copy

# ---------------------------------------------------------------------------
# HTTPS endpoint (optional)
# ---------------------------------------------------------------------------
# disabled | custodian-only | full   (OpenResty managed by seismic-node-ops)
# external                            (operator-managed terminator)
TLS_MODE=disabled
# Public domain served by OpenResty; required unless TLS_MODE=disabled.
DOMAIN=
# Externally visible Custodian base URL, e.g. https://node.example.com/custodian.
# Required when Custodian is exposed; used in instructions and observer config.
CUSTODIAN_PUBLIC_URL=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# (derived) Shared secret for JWT-protected routes; generated at install time.
OPENRESTY_JWT_SECRET_PATH=/etc/seismic/openresty-jwt-secret

# ---------------------------------------------------------------------------
# Monitoring (optional)
# ---------------------------------------------------------------------------
MONITORING_ENABLED=false
# Node label reported to the central Prometheus.
MONITORING_NODE_NAME=
# Remote-write endpoint.
MONITORING_REMOTE_WRITE_URL=
# (derived) Bearer token file, 0600, written at install time.
MONITORING_TOKEN_PATH=/etc/seismic/monitoring-token
MONITORING_DATA_DIR=/var/lib/prometheus-agent

# ---------------------------------------------------------------------------
# Runtime state (managed by seismic-node; listed for reference only)
# ---------------------------------------------------------------------------
# (derived) Written by `seismic-node checkpoint install`; its presence gates
# the checkpoint-start service variant.
CHECKPOINT_START_CONFIG=/etc/seismic/checkpoint-start.toml
WEAK_SUBJECTIVITY_PATH=/etc/seismic/weak-subjectivity.toml
