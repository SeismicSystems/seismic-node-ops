# Seismic Reth execution client. Shared by validators and observers.
# Static unit: every host-specific value comes from /etc/seismic/node.env.
#
# Summit depends on Reth's Engine API socket and fails when Reth fails; the
# Summit units declare Requires=seismic-reth.service, so their restart brings
# Reth back up first and the chain recovers in order.

[Unit]
Description=Seismic Reth execution client
Documentation=https://github.com/SeismicSystems/seismic-node-ops
After=network-online.target seismic-custodian.service seismic-observer-custodian.service
Wants=network-online.target
# Reth fetches purpose keys from the Custodian socket; one of the two role
# units is always installed and enabled.

[Service]
Type=simple
User=seismic
Group=seismic
EnvironmentFile=/etc/seismic/node.env
# /run/seismic holds the Engine API socket (and the Custodian socket when
# enabled); preserved so sibling services keep access across restarts.
RuntimeDirectory=seismic
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LimitNOFILE=65536
# systemd captures stdout/stderr in the journal. Disable Reth's default file
# logger so startup does not require a writable XDG cache/log directory.
ExecStart=/usr/local/bin/seismic-reth node -vvv --log.file.max-files 0 \
    --datadir ${RETH_DATA_DIR} \
    --p2p-secret-key ${RETH_P2P_KEY_PATH} \
    --http --http.addr 127.0.0.1 --http.port 8545 --http.api eth,net,web3 --http.corsdomain * \
    --ws --ws.addr 127.0.0.1 --ws.port 8546 --ws.api eth,net,web3 --ws.origins * \
    --port 30303 \
    --metrics 9001 \
    --ipcdisable \
    --auth-ipc --auth-ipc.path ${RETH_ENGINE_IPC} \
    --seismic.purpose-keys-source custodian \
    --seismic.custodian.socket ${CUSTODIAN_SOCKET} \
    --disable-discv4-discovery --disable-dns-discovery \
    --enable-discv5-discovery --discovery.v5.port 30303 \
    $RETH_BOOTNODES_ARG \
    --ops.enable --ops.addr 127.0.0.1 --ops.port 8552
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=mixed

[Install]
WantedBy=multi-user.target
