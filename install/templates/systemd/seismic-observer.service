# Seismic Summit consensus client, observer role, normal startup.
# Static unit: every host-specific value comes from /etc/seismic/node.env.
#
# Requires=seismic-reth.service makes an automatic restart of this unit bring
# Reth back up first, since Summit fails whenever Reth does.

[Unit]
Description=Seismic Summit consensus client (observer)
Documentation=https://github.com/SeismicSystems/seismic-node-ops
After=network-online.target seismic-reth.service
Wants=network-online.target
# Requires= so that an automatic restart of this unit starts Reth first.
Requires=seismic-reth.service
Conflicts=seismic-observer-checkpoint.service

[Service]
Type=simple
User=seismic
Group=seismic
EnvironmentFile=/etc/seismic/node.env
RuntimeDirectory=seismic
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LimitNOFILE=65536
# Metrics stay on loopback whatever SUMMIT_RPC_BIND is: the Prometheus Agent
# and the /prom-summit route scrape 127.0.0.1:9090, and nothing else should.
ExecStart=/usr/bin/flock --nonblock --no-fork ${SUMMIT_DATA_DIR}/.summit-process.lock \
    /usr/local/bin/summit run \
    --observer ${OBSERVER_INDEX} \
    --ip ${OBSERVER_PUBLIC_ADDRESS} \
    --port ${OBSERVER_P2P_PORT} \
    --genesis-path ${GENESIS_PATH} \
    --key-store-path ${SUMMIT_KEYS_DIR} \
    --store-path ${SUMMIT_DATA_DIR} \
    --engine-ipc-path ${RETH_ENGINE_IPC} \
    --rpc-ip ${SUMMIT_RPC_BIND} --rpc-port 3030 --admin-rpc-port 3031 \
    --prom-ip 127.0.0.1 --prom-port 9090 \
    --critical-log-dir ${SUMMIT_CRITICAL_LOG_DIR} \
    $SUMMIT_BOOTSTRAPPERS_ARG
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=mixed

[Install]
WantedBy=multi-user.target
