# Seismic Summit consensus client, validator role, normal startup.
# Static unit: every host-specific value comes from /etc/seismic/node.env.
#
# Restart=on-failure is safe for a voting process: Summit's consensus engine
# (Commonware Simplex) journals every vote it signs and fsyncs the journal
# before broadcasting, then replays it on start, so a restarted node cannot
# sign a conflicting vote for a view it already voted in. The unit is still
# not enabled at boot, so a reboot goes through `seismic-node validator start`.

[Unit]
Description=Seismic Summit consensus client (validator)
Documentation=https://github.com/SeismicSystems/seismic-node-ops
After=network-online.target seismic-reth.service
Wants=network-online.target
# Requires= so that an automatic restart of this unit starts Reth first.
Requires=seismic-reth.service
# Exactly one Summit process may own the key store and consensus state.
Conflicts=seismic-summit-checkpoint.service seismic-deposit-rpc.service

[Service]
Type=simple
User=seismic
Group=seismic
EnvironmentFile=/etc/seismic/node.env
RuntimeDirectory=seismic
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LimitNOFILE=65536
# flock takes the same kernel lock the seismic-node CLI holds while it moves
# consensus state, so Summit can never start mid-operation.
# RPC and metrics listen on loopback only: OpenResty is the public surface,
# the checkpointer and the Prometheus Agent (127.0.0.1:9090) are local.
ExecStart=/usr/bin/flock --nonblock --no-fork ${SUMMIT_DATA_DIR}/.summit-process.lock \
    /usr/local/bin/summit run \
    --genesis-path ${GENESIS_PATH} \
    --key-store-path ${SUMMIT_KEYS_DIR} \
    --store-path ${SUMMIT_DATA_DIR} \
    --engine-ipc-path ${RETH_ENGINE_IPC} \
    --rpc-ip 127.0.0.1 --rpc-port 3030 --admin-rpc-port 3031 \
    --prom-ip 127.0.0.1 --prom-port 9090 \
    --critical-log-dir ${SUMMIT_CRITICAL_LOG_DIR} \
    $SUMMIT_BOOTSTRAPPERS_ARG
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillMode=mixed

[Install]
WantedBy=multi-user.target
